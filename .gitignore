# This folder also holds the (unpublished) report, so the repo is an allowlist:
# ignore everything at the top level, then allow the published paths.
/*
!/.gitignore
!/.github/
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/SECURITY.md
!/CODE_OF_CONDUCT.md
!/.pre-commit-config.yaml
!/CITATION.cff
!/pyproject.toml
!/requirements.txt
!/configs/
!/data/
!/src/
!/tests/
!/web/
!/Dockerfile
!/.dockerignore
!/results/

# Build and tool caches inside the allowed folders
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
